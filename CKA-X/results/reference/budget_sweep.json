    "x_cols": [
      "cm_cka",
      "cm_r2"
    ],
    "cka_pt": "results/rebuild/cka_diverse.pt",
    "pool_file": "derived (labels + descriptor coverage)",
    "calibers": {
      "fold_mean": "metric per split, then mean +/- std over splits",
      "pooled": "all held-out predictions of all splits concatenated, one metric over n_splits*(N-k') points"
    }
